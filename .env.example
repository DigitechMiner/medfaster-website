# Copy to .env for local development. In production, set these in the Vercel project settings.

# Postgres connection string for the admin panel (Payload CMS), e.g. a Neon database.
# Without it the website still works and shows its built-in content; /admin is unavailable.
DATABASE_URI=postgres://user:password@localhost:5432/keraeva_website_cms

# Long random string used to sign admin logins: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Vercel Blob token for image uploads in production (uploads go to ./media locally)
BLOB_READ_WRITE_TOKEN=

# Public site URL, used for SEO tags and admin login security
NEXT_PUBLIC_SITE_URL=https://keraeva.com

# Optional: serve the admin panel from its own subdomain instead of keraeva.com/website,
# e.g. manage.keraeva.com (add the domain to the Vercel project and DNS first).
ADMIN_HOST=

# Where website form submissions are also forwarded (optional)
LEADS_WEBHOOK_URL=
